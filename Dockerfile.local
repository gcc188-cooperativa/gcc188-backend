# Imagem local de desenvolvimento (o build official usa Paketo via `bootBuildImage`).
# Mantém a API na 8080 e o Actuator na 8081, como esperado pelo compose.yaml.
FROM docker.io/library/eclipse-temurin:25-jdk-alpine AS build
WORKDIR /workspace
COPY gradlew settings.gradle.kts build.gradle.kts gradle.properties ./
COPY gradle ./gradle
COPY src ./src
RUN ./gradlew bootJar --no-daemon

FROM docker.io/library/eclipse-temurin:25-jre-alpine
WORKDIR /app
COPY --from=build /workspace/build/libs/gcc188-backend-*.jar app.jar
EXPOSE 8080 8081
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
